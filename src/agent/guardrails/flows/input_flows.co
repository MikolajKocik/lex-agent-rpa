# bezpieczeństwo prompt injection flow
define flow check jailbreak
  $is_safe = execute check_jailbreak
  if not $is_safe
    bot refuse to respond
    stop

define flow mask sensitive data on input
  $result = execute mask_pii
  $last_user_message = $result.last_user_message

define bot refuse to respond off topic
  "Przepraszam, ale jestem wirtualnym asystentem prawnym i nie posiadam informacji niezwiązanych z zakresem moich obowiązków (np. kulinarnych)."

define flow check off topic
  $is_on_topic = execute check_off_topic
  if not $is_on_topic
    bot refuse to respond off topic
    stop

