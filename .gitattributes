# Auto detect text files and perform LF normalization
* text=auto

#
# Custom for Python
#
*.py    text diff=python
*.pyc   binary
*.pyo   binary
*.pyd   binary

# Jupyter Notebooks
*.ipynb text diff=python

# Shell scripts should always have LF line endings
*.sh    text eol=lf

# Batch scripts should always have CRLF line endings
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Data files
*.csv   text
*.json  text

# Binaries
*.dll   binary
*.so    binary
*.exe   binary
